<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inho.mespractice.item.repository.ItemMapper">

  <resultMap id="itemResultMap" type="com.inho.mespractice.item.entity.Item">
    <id property="itemId" column="item_id"/>
    <result property="itemCode" column="item_code"/>
    <result property="itemName" column="item_name"/>
    <result property="unit" column="unit"/>
  </resultMap>
  
  <insert id="insertItem" parameterType="com.inho.mespractice.item.entity.Item" useGeneratedKeys="true" keyProperty="itemId">
    INSERT INTO item (item_code, item_name, unit)
    VALUES (#{itemCode}, #{itemName}, #{unit})
  </insert>

  <select id="findById" resultMap="itemResultMap">
    SELECT item_id, item_code, item_name, unit
    FROM item
    WHERE item_id = #{itemId}
  </select>

  <select id="findAll" resultMap="itemResultMap">
    SELECT item_id, item_code, item_name, unit
    FROM item
    ORDER BY item_id
  </select>
  
  <update id="updateItem" parameterType="com.inho.mespractice.item.entity.Item">
    UPDATE item
    SET item_name = #{itemName}, unit = #{unit}
    WHERE item_id = #{itemId}
  </update>

  <delete id="deleteById">
    DELETE FROM item
    WHERE item_id = #{itemId}
  </delete>
</mapper>